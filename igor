import argparse
import enum
import http
import os
import subprocess
import sys
import time
import tomllib
import urllib3

import platformdirs
import requests


def util__get_config():
    path = os.path.join(platformdirs.user_config_dir("igor"), "systems.toml")
    with open(path, "rb") as f:
        config = tomllib.load(f)
    return config


def util__ssh(spec):
    comm = [
        "sshpass",
        "-p",
        spec["pass"],
        "ssh",
        "-o",
        "StrictHostKeyChecking=no",
        "-C",
        f"{spec["user"]}@{spec["addr"]}",
        "-p",
        str(spec["port"]),
    ]

    with subprocess.Popen(comm, shell=False) as process:
        process.wait()


def util__check_response(response):
    if not response.ok:
        print(
            f"error: bad response "
            f"{response.status_code} "
            f"({http.client.responses[response.status_code]})"
        )
        sys.exit()


def bmc__get_token(spec):
    url = f"https://{spec["addr"]}/login"
    json = {"username": spec["user"], "password": spec["pass"]}
    response = requests.post(url, json=json, verify=False, timeout=10)
    response.close()
    util__check_response(response)
    return response.json()["token"]


def bmc__put_token(spec, token):
    url = f"https://{spec["addr"]}/logout"
    headers = {"X-Auth-Token": token}
    json = {"data": []}
    response = requests.post(
        url, headers=headers, json=json, verify=False, timeout=10
    )
    response.close()
    util__check_response(response)


class bmc__power_state(enum.Enum):
    ON = "xyz.openbmc_project.State.Chassis.PowerState.On"
    OFF = "xyz.openbmc_project.State.Chassis.PowerState.Off"


class bmc__transition(enum.Enum):
    ON = "xyz.openbmc_project.State.Chassis.Transition.On"
    OFF = "xyz.openbmc_project.State.Chassis.Transition.Off"


def bmc__get_power_state(spec, token):
    url = f"https://{spec["addr"]}/xyz/openbmc_project/state/chassis0"
    headers = {"X-Auth-Token": token}
    response = requests.get(url, headers=headers, verify=False, timeout=10)
    response.close()
    util__check_response(response)
    state = response.json()["data"]["CurrentPowerState"]
    return bmc__power_state(state)


def bmc__set_power_state(spec, token, state):
    url = f"https://{spec["addr"]}/xyz/openbmc_project/state/chassis0/attr/RequestedPowerTransition"
    headers = {"X-Auth-Token": token}
    json = {"data": state.value}
    response = requests.put(
        url, headers=headers, json=json, verify=False, timeout=10
    )
    response.close()
    util__check_response(response)

    state = bmc__power_state[state.name]
    while state is not bmc__get_power_state(spec, token):
        time.sleep(1)


class pdu__power_state(enum.Enum):
    ON = 1
    OFF = 0


def pdu__get_power_state(spec):
    url = f"https://{spec["addr"]}/model/pdu/0/outlet/{spec["port"]}"
    headers = {"Content-Type": "application/x-www-form-urlencoded"}
    json = {"jsonrpc": "2.0", "method": "getState"}
    response = requests.post(
        url,
        headers=headers,
        json=json,
        verify=False,
        timeout=10,
        auth=(spec["user"], spec["pass"]),
    )
    response.close()
    util__check_response(response)
    json = response.json()["result"]["_ret_"]
    state = json["powerState"]
    return pdu__power_state(state)


def pdu__set_power_state(spec, state):
    url = f"https://{spec["addr"]}/model/pdu/0/outlet/{spec["port"]}"
    headers = {"Content-Type": "application/x-www-form-urlencoded"}
    json = {
        "jsonrpc": "2.0",
        "method": "setPowerState",
        "params": {"pstate": state.value},
    }
    response = requests.post(
        url,
        headers=headers,
        json=json,
        verify=False,
        timeout=10,
        auth=(spec["user"], spec["pass"]),
    )
    response.close()
    util__check_response(response)


def pdu__cycle_power_state(spec):
    url = f"https://{spec["addr"]}/model/pdu/0/outlet/{spec["port"]}"
    headers = {"Content-Type": "application/x-www-form-urlencoded"}
    json = {"jsonrpc": "2.0", "method": "cyclePowerState"}
    response = requests.post(
        url,
        headers=headers,
        json=json,
        verify=False,
        timeout=10,
        auth=(spec["user"], spec["pass"]),
    )
    response.close()
    util__check_response(response)


def system__get_host(system):
    if "host" not in system.keys():
        sys.exit("error: invalid host")

    host = system["host"]
    if not all(k in host.keys() for k in ("addr", "user", "pass")):
        sys.exit("error: invalid host")

    # set host defaults
    if "port" not in host.keys():
        host["port"] = 22

    return host


def system__get_bmc(system):
    if "bmc" not in system.keys():
        sys.exit("error: invalid bmc")

    bmc = system["bmc"]
    if "addr" not in bmc.keys():
        sys.exit("error: invalid bmc")

    # set bmc defaults
    if "user" not in bmc.keys():
        bmc["user"] = "root"
    if "pass" not in bmc.keys():
        bmc["pass"] = "0penBmc"
    if "port" not in bmc.keys():
        bmc["port"] = 2200

    return bmc


def system__get_pdu(system):
    if "pdu" not in system.keys():
        sys.exit("error: invalid pdu")

    pdu = system["pdu"]
    if not all(k in pdu.keys() for k in ("addr", "port")) or not isinstance(
        pdu["port"], int
    ):
        sys.exit("error: invalid pdu")

    # set pdu defaults
    if "user" not in pdu.keys():
        pdu["user"] = "admin"
    if "pass" not in pdu.keys():
        pdu["pass"] = "raritan"

    return pdu


def main():
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
    parser = argparse.ArgumentParser("igor")
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument(
        "--connect",
        "-c",
        action="store_true",
        help="connect to the host over ssh",
    )
    action.add_argument(
        "--console",
        "-k",
        action="store_true",
        help="connect to the serial console over ssh",
    )
    action.add_argument(
        "--get-power",
        "-q",
        action="store_true",
        help="get the host power state of the system",
    )
    action.add_argument(
        "--set-power",
        "-p",
        metavar=("STATE"),
        help="set the host power state of the system",
    )
    action.add_argument(
        "--cycle-power",
        "-r",
        action="store_true",
        help="perform a host power cycle of the system",
    )
    action.add_argument(
        "--get-inlet",
        "-Q",
        action="store_true",
        help="get the inlet power state of the system",
    )
    action.add_argument(
        "--set-inlet",
        "-P",
        metavar=("STATE"),
        help="set the inlet power state of the system",
    )
    action.add_argument(
        "--cycle-inlet",
        "-R",
        action="store_true",
        help="perform a inlet power cycle of the system",
    )
    parser.add_argument(
        "system", metavar="SYSTEM", help="specify the system to be used"
    )
    args = parser.parse_args()

    config = util__get_config()
    if not args.system or args.system not in config.keys():
        sys.exit("error: invalid system")

    system = config[args.system]

    if args.connect:
        host = system__get_host(system)
        util__ssh(host)

    elif args.console:
        bmc = system__get_bmc(system)
        util__ssh(bmc)

    elif args.get_power:
        bmc = system__get_bmc(system)
        token = bmc__get_token(bmc)
        state = bmc__get_power_state(bmc, token)
        bmc__put_token(bmc, token)
        print(f"info: host power state is {state.name}")

    elif args.set_power:
        bmc = system__get_bmc(system)
        state = args.set_power.upper()
        if state not in bmc__transition._member_names_:
            sys.exit("error: invalid host power state")

        state = bmc__transition[state]
        token = bmc__get_token(bmc)
        bmc__set_power_state(bmc, token, state)
        bmc__put_token(bmc, token)
        print(f"info: host power state is {state.name}")

    elif args.cycle_power:
        bmc = system__get_bmc(system)
        token = bmc__get_token(bmc)
        state = bmc__get_power_state(bmc, token)
        if state is bmc__power_state.ON:
            bmc__set_power_state(bmc, token, bmc__transition.OFF)

        bmc__set_power_state(bmc, token, bmc__transition.ON)
        bmc__put_token(bmc, token)

    elif args.get_inlet:
        pdu = system__get_pdu(system)
        state = pdu__get_power_state(pdu)
        print(f"info: inlet power state is {state.name}")

    elif args.set_inlet:
        pdu = system__get_pdu(system)
        state = args.set_inlet.upper()
        if state not in pdu__power_state._member_names_:
            sys.exit("error: invalid inlet power state")

        state = pdu__power_state[state]
        pdu__set_power_state(pdu, state)
        print(f"info: inlet power state is {state.name}")

    elif args.cycle_power:
        pdu = system__get_pdu(system)
        state = pdu__power_state[state]
        if state is pdu__power_state.ON:
            pdu__cycle_power_state(pdu)


if __name__ == "__main__":
    try:
        main()
    except requests.exceptions.ConnectionError:
        print("error: connection failed")
